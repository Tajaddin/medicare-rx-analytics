# Copy to .env (git-ignored). Every value below is a safe local default; nothing here is a secret.

# --- pipeline (rx) ---
RX_STATE=FL
RX_YEARS=2022,2023,2024
RX_RAW_DIR=data/raw
RX_REPORTS_DIR=reports
RX_EXPORTS_DIR=bi/exports
# host:port of a Prometheus Pushgateway; unset = metrics are printed instead of pushed
# RX_PUSHGATEWAY=127.0.0.1:9091

# --- Snowflake connection ---
# Defaults point at the local emulator (`make emulator` or `make up`).
SNOWFLAKE_ACCOUNT=fakesnow
SNOWFLAKE_USER=fake
SNOWFLAKE_PASSWORD=snow
SNOWFLAKE_HOST=127.0.0.1
SNOWFLAKE_PORT=8085
SNOWFLAKE_DATABASE=RX
SNOWFLAKE_WAREHOUSE=RX_WH

# A real account instead (docs/DEPLOY.md): set these in your shell or a secret store, never in a committed file.
# Sign-in is by key pair (Snowflake refuses password-only sign-in for service users); keep the key outside the repo.
# SNOWFLAKE_ACCOUNT=<orgname-accountname>
# SNOWFLAKE_USER=RX_PIPELINE
# SNOWFLAKE_PRIVATE_KEY_FILE=/path/outside/the/repo/rx_pipeline_key.p8
# SNOWFLAKE_ROLE=RX_TRANSFORMER
# DBT_TARGET=snowflake

# --- extractor (scripts/extract_cms.sh) ---
# CMS_API_BASE=https://data.cms.gov/data-api/v1/dataset
# PAGE_SIZE=5000
# MAX_RETRIES=5
# RETRY_DELAY=2
# PAUSE=0.2

# --- local Grafana (docker compose) ---
GRAFANA_ADMIN_PASSWORD=change-me-locally
