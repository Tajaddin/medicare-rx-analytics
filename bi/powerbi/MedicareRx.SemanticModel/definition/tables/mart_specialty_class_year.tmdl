/// Claims and cost by prescriber specialty and therapeutic class.
table mart_specialty_class_year
	lineageTag: ab1792ea-e3b4-5a09-a4d3-4a5fb5fc4af8

	column prescriber_type
		dataType: string
		lineageTag: eba046cc-c4b1-5015-83f0-b4b29008d2d3
		summarizeBy: none
		sourceColumn: prescriber_type

	column drug_class
		dataType: string
		isHidden
		lineageTag: 02599958-8ad9-5347-8307-c63ebbd4f101
		summarizeBy: none
		sourceColumn: drug_class

	column data_year
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: b8ecacf8-3133-5081-bda0-e4d221606e5f
		summarizeBy: none
		sourceColumn: data_year

	column claims
		dataType: double
		formatString: #,0
		lineageTag: ff0053ae-e13f-5957-b40f-9ab9271d179c
		summarizeBy: sum
		sourceColumn: claims

	column drug_cost
		dataType: double
		formatString: \$#,0
