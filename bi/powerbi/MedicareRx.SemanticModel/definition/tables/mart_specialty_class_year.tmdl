		formatString: 0.0%
		lineageTag: 333f5cf5-dd6b-598d-9b64-aebd897bcba4
		summarizeBy: none
		sourceColumn: share_of_specialty_claims

	column cost_per_claim
		dataType: double
		formatString: \$#,0.00
		lineageTag: fe29fec3-44e1-566a-9edf-3d90b72e712a
		summarizeBy: none
		sourceColumn: cost_per_claim

	partition mart_specialty_class_year = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportsFolder & "\mart_specialty_class_year.parquet"))
				in
				    Source
