		summarizeBy: sum
		sourceColumn: drug_cost

	column prescribers
		dataType: int64
		formatString: #,0
		lineageTag: 843a87d6-a9da-5a19-ad4d-15ac31f7a1cd
		summarizeBy: sum
		sourceColumn: prescribers

	column share_of_specialty_claims
